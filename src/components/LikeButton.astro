---
import LikeButtonClient from './LikeButton.tsx';

const {
  sayingId,
  initialLiked = false,
  totalLikes = 0,
  isAuthenticated = false,
  class: className = '',
}: {
  sayingId: number;
  initialLiked?: boolean;
  totalLikes: number;
  isAuthenticated?: boolean;
  class?: string;
} = Astro.props;
---

<LikeButtonClient
  client:load
  sayingId={sayingId}
  initialLiked={initialLiked}
  totalLikes={totalLikes}
  isAuthenticated={isAuthenticated}
  className={className}
/>
